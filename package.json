{
  "name": "ibs-saxony-react-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build && node scripts/build-static-php.mjs",
